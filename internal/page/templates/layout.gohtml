{{define "layout"}}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <script>
            try {
                const theme = localStorage.getItem("theme");

                if (theme === "light" || theme === "dark") {
                    document.documentElement.dataset.theme = theme;
                }
            } catch {
                // localStorage may be blocked or unavailable.
            }
        </script>
        <link rel="icon" type="image/svg+xml" href="{{assetURL "favicon.svg"}}" />
        <link rel="stylesheet" href="{{assetURL "unpoly.min.css"}}" />
        <link rel="stylesheet" href="{{assetURL "styles.css"}}" />
        <script type="module" src="{{assetURL "app.js"}}" up-boot="manual"></script>
        <title>{{block "title" .}}{{ end }}</title>
    </head>
    <body>
        {{template "svgsprite" .}}
        {{template "header" .}}
        <main up-main>{{block "main" .}}{{end}}</main>
        {{template "footer" .}}
    </body>
</html>
{{ end }}
